{
  "fonts": [
    { "id": "glyphs", "src": [{ "path": "./glyphs.woff", "format": "woff" }], "weight": "normal", "style": "normal", "size": "150%" },
    { "id": "small", "src": [{ "path": "./small.woff", "format": "woff" }], "size": "100%" }
  ],
  "iconDefinitions": {
    "_default": { "fontCharacter": "\\E023", "fontColor": "#d4d7d6" },
    "_default_light": { "fontCharacter": "\\E023", "fontColor": "#bfc2c1" },
    "_yml": { "fontCharacter": "\\E0A7", "fontColor": "#a074c4" },
    "_yml_light": { "fontCharacter": "\\E0A7", "fontColor": "#9068b0" },
    "_json": { "fontCharacter": "\\E055", "fontColor": "#cbcb41" },
    "_ts": { "fontCharacter": "\\E0B0", "fontColor": "#519aba" },
    "_ts_hc": { "fontCharacter": "\\E0B0", "fontColor": "#ffffff" },
    "_dts": { "fontCharacter": "\\E0B1", "fontColor": "#519aba", "fontSize": "120%" },
    "_docker": { "fontCharacter": "\\E040", "fontColor": "not a color" },
    "_lock": { "fontCharacter": "\\E060", "fontId": "small" },
    "_color_only": { "fontColor": "#ff0000" }
  },
  "file": "_default",
  "fileExtensions": { "ts": "_ts", "D.TS": "_dts", "lock": "_lock", "md": "_color_only" },
  "fileNames": { "dockerfile": "_docker" },
  "languageIds": { "yaml": "_yml", "json": "_json", "typescript": "_ts" },
  "light": {
    "file": "_default_light",
    "languageIds": { "yaml": "_yml_light" }
  },
  "highContrast": {
    "fileExtensions": { "ts": "_ts_hc" }
  }
}
