{
    "name": "search-plus-plus",
    "displayName": "Search Plus Plus",
    "description": "Search text and the key paths of YAML, JSON and TOML files. Typos and umlaut spellings match by default.",
    "version": "0.1.1",
    "publisher": "bjoern621",
    "license": "MIT",
    "private": true,
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/bjoern621/search-plus-plus.git"
    },
    "bugs": {
        "url": "https://github.com/bjoern621/search-plus-plus/issues"
    },
    "homepage": "https://github.com/bjoern621/search-plus-plus#readme",
    "keywords": [
        "search",
        "find in files",
        "fuzzy",
        "umlaut",
        "yaml",
        "json",
        "toml",
        "key path"
    ],
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "searchPlusPlus",
                    "title": "Search++",
                    "icon": "media/search.svg"
                }
            ]
        },
        "views": {
            "searchPlusPlus": [
                {
                    "type": "webview",
                    "id": "searchPlusPlus.view",
                    "name": "Search++"
                }
            ]
        },
        "commands": [
            {
                "command": "searchPlusPlus.focus",
                "title": "Focus Search",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.openSettings",
                "title": "Open Settings",
                "category": "Search++",
                "icon": "$(gear)"
            },
            {
                "command": "searchPlusPlus.viewAsTree",
                "title": "View as Tree",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != tree"
            },
            {
                "command": "searchPlusPlus.viewAsList",
                "title": "View as List",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != list"
            },
            {
                "command": "searchPlusPlus.turnOff.matchCase",
                "title": "✓ Match Case",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOn.matchCase",
                "title": "  Match Case",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOff.matchWholeWord",
                "title": "✓ Match Whole Word",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOn.matchWholeWord",
                "title": "  Match Whole Word",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOff.umlautVariants",
                "title": "✓ Umlaut Variants",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOn.umlautVariants",
                "title": "  Umlaut Variants",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOff.fuzzy",
                "title": "✓ Fuzzy Matches",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOn.fuzzy",
                "title": "  Fuzzy Matches",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOff.searchIgnoredFiles",
                "title": "✓ Search Ignored Files",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.turnOn.searchIgnoredFiles",
                "title": "  Search Ignored Files",
                "category": "Search++"
            }
        ],
        "submenus": [
            {
                "id": "searchPlusPlus.viewAs",
                "label": "View As",
                "icon": "$(list-flat)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "submenu": "searchPlusPlus.viewAs",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.openSettings",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@2"
                },
                {
                    "command": "searchPlusPlus.turnOff.matchCase",
                    "when": "view == searchPlusPlus.view && config.searchPlusPlus.matchCase",
                    "group": "1_matching@1"
                },
                {
                    "command": "searchPlusPlus.turnOn.matchCase",
                    "when": "view == searchPlusPlus.view && !config.searchPlusPlus.matchCase",
                    "group": "1_matching@1"
                },
                {
                    "command": "searchPlusPlus.turnOff.matchWholeWord",
                    "when": "view == searchPlusPlus.view && config.searchPlusPlus.matchWholeWord",
                    "group": "1_matching@2"
                },
                {
                    "command": "searchPlusPlus.turnOn.matchWholeWord",
                    "when": "view == searchPlusPlus.view && !config.searchPlusPlus.matchWholeWord",
                    "group": "1_matching@2"
                },
                {
                    "command": "searchPlusPlus.turnOff.umlautVariants",
                    "when": "view == searchPlusPlus.view && config.searchPlusPlus.umlautVariants",
                    "group": "1_matching@3"
                },
                {
                    "command": "searchPlusPlus.turnOn.umlautVariants",
                    "when": "view == searchPlusPlus.view && !config.searchPlusPlus.umlautVariants",
                    "group": "1_matching@3"
                },
                {
                    "command": "searchPlusPlus.turnOff.fuzzy",
                    "when": "view == searchPlusPlus.view && config.searchPlusPlus.fuzzy",
                    "group": "1_matching@4"
                },
                {
                    "command": "searchPlusPlus.turnOn.fuzzy",
                    "when": "view == searchPlusPlus.view && !config.searchPlusPlus.fuzzy",
                    "group": "1_matching@4"
                },
                {
                    "command": "searchPlusPlus.turnOff.searchIgnoredFiles",
                    "when": "view == searchPlusPlus.view && config.searchPlusPlus.searchIgnoredFiles",
                    "group": "2_files@1"
                },
                {
                    "command": "searchPlusPlus.turnOn.searchIgnoredFiles",
                    "when": "view == searchPlusPlus.view && !config.searchPlusPlus.searchIgnoredFiles",
                    "group": "2_files@1"
                }
            ],
            "searchPlusPlus.viewAs": [
                {
                    "command": "searchPlusPlus.viewAsTree",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.viewAsList",
                    "group": "navigation@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "searchPlusPlus.turnOff.matchCase",
                    "when": "config.searchPlusPlus.matchCase"
                },
                {
                    "command": "searchPlusPlus.turnOn.matchCase",
                    "when": "!config.searchPlusPlus.matchCase"
                },
                {
                    "command": "searchPlusPlus.turnOff.matchWholeWord",
                    "when": "config.searchPlusPlus.matchWholeWord"
                },
                {
                    "command": "searchPlusPlus.turnOn.matchWholeWord",
                    "when": "!config.searchPlusPlus.matchWholeWord"
                },
                {
                    "command": "searchPlusPlus.turnOff.umlautVariants",
                    "when": "config.searchPlusPlus.umlautVariants"
                },
                {
                    "command": "searchPlusPlus.turnOn.umlautVariants",
                    "when": "!config.searchPlusPlus.umlautVariants"
                },
                {
                    "command": "searchPlusPlus.turnOff.fuzzy",
                    "when": "config.searchPlusPlus.fuzzy"
                },
                {
                    "command": "searchPlusPlus.turnOn.fuzzy",
                    "when": "!config.searchPlusPlus.fuzzy"
                },
                {
                    "command": "searchPlusPlus.turnOff.searchIgnoredFiles",
                    "when": "config.searchPlusPlus.searchIgnoredFiles"
                },
                {
                    "command": "searchPlusPlus.turnOn.searchIgnoredFiles",
                    "when": "!config.searchPlusPlus.searchIgnoredFiles"
                }
            ]
        },
        "keybindings": [
            {
                "command": "searchPlusPlus.focus",
                "key": "ctrl+shift+f",
                "mac": "cmd+shift+f"
            }
        ],
        "configuration": {
            "title": "Search++",
            "properties": {
                "searchPlusPlus.matchCase": {
                    "type": "boolean",
                    "default": false,
                    "order": 1,
                    "markdownDescription": "A query word finds only text in its own case: `Secret` leaves out `secret`. Quotes around a word do this for that word alone."
                },
                "searchPlusPlus.matchWholeWord": {
                    "type": "boolean",
                    "default": false,
                    "order": 2,
                    "markdownDescription": "A query word finds only whole words: `grav` leaves out `gravitee`. Key paths compare whole keys either way."
                },
                "searchPlusPlus.umlautVariants": {
                    "type": "boolean",
                    "default": true,
                    "order": 3,
                    "markdownDescription": "Each umlaut and its spelled-out form find each other: `Größe` finds `Groesse`, and `Groesse` finds `Größe`. Turn it off when the two spellings stand for different words."
                },
                "searchPlusPlus.fuzzy": {
                    "type": "boolean",
                    "default": true,
                    "order": 4,
                    "markdownDescription": "A query word also finds words a letter or two off: `secret` finds `socket`. Words under three letters match exactly either way. Turn it off when these matches crowd the results."
                },
                "searchPlusPlus.fuzzyOneEditMinLetters": {
                    "type": "integer",
                    "default": 3,
                    "minimum": 1,
                    "markdownDescription": "A query word of this many letters or more also finds words one letter off. Raise it when short words pull in unrelated matches. Needs `#searchPlusPlus.fuzzy#`.",
                    "order": 5
                },
                "searchPlusPlus.fuzzyTwoEditsMinLetters": {
                    "type": "integer",
                    "default": 6,
                    "minimum": 1,
                    "markdownDescription": "A query word of this many letters or more also finds words two letters off. Raise it when long words pull in unrelated matches. Needs `#searchPlusPlus.fuzzy#`.",
                    "order": 6
                },
                "searchPlusPlus.searchIgnoredFiles": {
                    "type": "boolean",
                    "default": false,
                    "order": 7,
                    "markdownDescription": "Searches the files that the ignore files hide, such as `.gitignore`. Turn it on to find text in `node_modules` or build output. A search over many ignored files takes longer."
                },
                "searchPlusPlus.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Globs of files and folders that every search leaves out, such as `**/generated`. Every search also leaves out what `#files.exclude#` hides. `#search.exclude#` hides nothing from Search++.",
                    "order": 8
                },
                "searchPlusPlus.maxResults": {
                    "type": "integer",
                    "default": 10000,
                    "minimum": 1,
                    "markdownDescription": "Matched lines that a search shows at most. A search that reaches the limit stops and says so. A higher limit makes a broad search slower to finish.",
                    "order": 9
                },
                "searchPlusPlus.contextLines": {
                    "order": 10,
                    "type": "integer",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Lines shown dimmed before and after each match. Raise it to read more around a match without opening the file."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "bench": "node scripts/bench.mjs",
        "sbom": "cyclonedx-npm --omit dev --output-reproducible --output-format JSON --output-file sbom.cdx.json",
        "sbom:check": "node scripts/check-sbom.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "vscode:prepublish": "npm run build",
        "package": "vsce package"
    },
    "devDependencies": {
        "@cyclonedx/cyclonedx-npm": "7.0.1",
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "@vscode/vsce": "4.1.0",
        "esbuild": "0.28.2",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "dependencies": {
        "@vscode/codicons": "0.0.45",
        "jsonc-parser": "3.3.1"
    }
}
