{
    "name": "search-plus-plus",
    "displayName": "Search++",
    "description": "Search by key paths in YAML, JSON and TOML, with typo and umlaut matching by default.",
    "version": "0.0.1",
    "publisher": "bjoern621",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "searchPlusPlus",
                    "title": "Search++",
                    "icon": "media/search.svg"
                }
            ]
        },
        "views": {
            "searchPlusPlus": [
                {
                    "type": "webview",
                    "id": "searchPlusPlus.view",
                    "name": "Search++"
                }
            ]
        },
        "commands": [
            {
                "command": "searchPlusPlus.focus",
                "title": "Search++: Focus Search"
            },
            {
                "command": "searchPlusPlus.openSettings",
                "title": "Open Settings",
                "category": "Search++",
                "icon": "$(gear)"
            },
            {
                "command": "searchPlusPlus.viewAsTree",
                "title": "View as Tree",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != tree"
            },
            {
                "command": "searchPlusPlus.viewAsList",
                "title": "View as List",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != list"
            }
        ],
        "submenus": [
            {
                "id": "searchPlusPlus.viewAs",
                "label": "View As",
                "icon": "$(list-flat)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "submenu": "searchPlusPlus.viewAs",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.openSettings",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@2"
                }
            ],
            "searchPlusPlus.viewAs": [
                {
                    "command": "searchPlusPlus.viewAsTree",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.viewAsList",
                    "group": "navigation@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "searchPlusPlus.focus",
                "key": "ctrl+shift+f",
                "mac": "cmd+shift+f"
            }
        ],
        "configuration": {
            "title": "Search++",
            "properties": {
                "searchPlusPlus.contextLines": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Lines shown dimmed before and after each match. Raise it to read more around a match without opening the file."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "sbom": "cyclonedx-npm --omit dev --output-reproducible --output-format JSON --output-file sbom.cdx.json",
        "sbom:check": "node scripts/check-sbom.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@cyclonedx/cyclonedx-npm": "7.0.1",
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "esbuild": "0.28.2",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "dependencies": {
        "@vscode/codicons": "0.0.45",
        "jsonc-parser": "3.3.1"
    }
}
