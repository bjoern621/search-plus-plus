{
  "name": "structural-search",
  "displayName": "Structural Search",
  "description": "Search by key paths in YAML, JSON and TOML, with typo and umlaut matching by default.",
  "version": "0.0.1",
  "publisher": "bjoern621",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "structuralSearch",
          "title": "Structural Search",
          "icon": "media/search.svg"
        }
      ]
    },
    "views": {
      "structuralSearch": [
        {
          "type": "webview",
          "id": "structuralSearch.view",
          "name": "Structural Search"
        }
      ]
    },
    "commands": [
      {
        "command": "structuralSearch.focus",
        "title": "Structural Search: Focus Search"
      }
    ],
    "keybindings": [
      {
        "command": "structuralSearch.focus",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "sbom": "cyclonedx-npm --omit dev --output-reproducible --output-format JSON --output-file sbom.cdx.json",
    "sbom:check": "node scripts/check-sbom.mjs"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
