{
    "name": "search-plus-plus",
    "displayName": "Search++",
    "description": "Search text and the key paths of YAML, JSON and TOML files. Typos and umlaut spellings match by default.",
    "version": "0.0.1",
    "publisher": "bjoern621",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "searchPlusPlus",
                    "title": "Search++",
                    "icon": "media/search.svg"
                }
            ]
        },
        "views": {
            "searchPlusPlus": [
                {
                    "type": "webview",
                    "id": "searchPlusPlus.view",
                    "name": "Search++"
                }
            ]
        },
        "commands": [
            {
                "command": "searchPlusPlus.focus",
                "title": "Focus Search",
                "category": "Search++"
            },
            {
                "command": "searchPlusPlus.openSettings",
                "title": "Open Settings",
                "category": "Search++",
                "icon": "$(gear)"
            },
            {
                "command": "searchPlusPlus.viewAsTree",
                "title": "View as Tree",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != tree"
            },
            {
                "command": "searchPlusPlus.viewAsList",
                "title": "View as List",
                "category": "Search++",
                "enablement": "searchPlusPlus.resultsLayout != list"
            }
        ],
        "submenus": [
            {
                "id": "searchPlusPlus.viewAs",
                "label": "View As",
                "icon": "$(list-flat)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "submenu": "searchPlusPlus.viewAs",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.openSettings",
                    "when": "view == searchPlusPlus.view",
                    "group": "navigation@2"
                }
            ],
            "searchPlusPlus.viewAs": [
                {
                    "command": "searchPlusPlus.viewAsTree",
                    "group": "navigation@1"
                },
                {
                    "command": "searchPlusPlus.viewAsList",
                    "group": "navigation@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "searchPlusPlus.focus",
                "key": "ctrl+shift+f",
                "mac": "cmd+shift+f"
            }
        ],
        "configuration": {
            "title": "Search++",
            "properties": {
                "searchPlusPlus.matchCase": {
                    "type": "boolean",
                    "default": false,
                    "order": 1,
                    "markdownDescription": "A query word finds only text in its own case: `Secret` leaves out `secret`. Quotes around a word do this for that word alone."
                },
                "searchPlusPlus.matchWholeWord": {
                    "type": "boolean",
                    "default": false,
                    "order": 2,
                    "markdownDescription": "A query word finds only whole words: `grav` leaves out `gravitee`. Key paths compare whole keys either way."
                },
                "searchPlusPlus.umlautVariants": {
                    "type": "boolean",
                    "default": true,
                    "order": 3,
                    "markdownDescription": "Each umlaut and its spelled-out form find each other: `Größe` finds `Groesse`, and `Groesse` finds `Größe`. Turn it off when the two spellings stand for different words."
                },
                "searchPlusPlus.fuzzy": {
                    "type": "boolean",
                    "default": true,
                    "order": 4,
                    "markdownDescription": "A query word also finds words a letter or two off: `secret` finds `socket`. Words under three letters match exactly either way. Turn it off when these matches crowd the results."
                },
                "searchPlusPlus.contextLines": {
                    "order": 5,
                    "type": "integer",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Lines shown dimmed before and after each match. Raise it to read more around a match without opening the file."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "sbom": "cyclonedx-npm --omit dev --output-reproducible --output-format JSON --output-file sbom.cdx.json",
        "sbom:check": "node scripts/check-sbom.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@cyclonedx/cyclonedx-npm": "7.0.1",
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "esbuild": "0.28.2",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "dependencies": {
        "@vscode/codicons": "0.0.45",
        "jsonc-parser": "3.3.1"
    }
}
